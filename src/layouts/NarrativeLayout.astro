---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Channel-by-channel profitability analysis for Cinderhaven, a specialty food brand. Where contribution margin is earned — and where it disappears." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Where contribution margin is earned — and where it disappears." />
    <meta property="og:type" content="article" />
    <link rel="preload" href="/fonts/playfair-display-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <link rel="stylesheet" href="/src/styles/print.css" />
  </head>
  <body>
    <main class="narrative">
      <slot />
    </main>
    <style>
      .narrative {
        max-width: var(--content-max-width);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: var(--section-gap);
      }
    </style>
  </body>
</html>
