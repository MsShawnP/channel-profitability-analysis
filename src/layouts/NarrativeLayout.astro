---
import '../styles/global.css';
import '../styles/print.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Channel-by-channel profitability analysis for Cinderhaven, a specialty food brand. Where contribution margin is earned — and where it disappears." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Where contribution margin is earned — and where it disappears." />
    <meta property="og:type" content="article" />
    <link rel="preload" href="/fonts/playfair-display-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/lailara-frame.css" />
  </head>
  <body>
    <div class="lailara-page">
      <header class="lailara-header">
        <nav class="lailara-nav-inner">
          <a href="https://lailarallc.com" class="lailara-wordmark">Lailara LLC</a>
          <span class="lailara-tool-name">Channel Profitability</span>
        </nav>
      </header>

      <main class="lailara-main">
        <div class="lailara-container">
          <slot />
        </div>
      </main>

      <footer class="lailara-footer">
        <div class="lailara-footer-inner">
          <p>Built by <a href="https://lailarallc.com">Lailara LLC</a> &mdash; data hygiene and analytics consulting for specialty food brands scaling into national retail.</p>
        </div>
      </footer>
    </div>
  </body>
</html>
